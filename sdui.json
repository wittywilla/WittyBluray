      "type": "wittybluray.refusal",
      "label": "Can't play",
      "description": "An encrypted Blu-ray: a plain message saying so, that nothing was changed or copied, and what the disc's index still says.",
      "icon": "warning",
      "category": "",
      "params": [
        {
          "name": "item",
          "type": "ref",
          "label": "Disc",
          "help": "$item on a Blu-ray's page.",
          "required": true,
          "since": 0
        }
      ],
      "yields": [
        "view"
      ],
      "cardStyle": "landscape",
      "pageKinds": [
        "detail"
      ],
      "paged": false,
      "title": "This disc can't be played",
      "since": 8
    },
