  "commands": [
    {
      "op": "wittybluray.choose",
      "label": "Make it the film",
      "description": "An administrator makes params.ttn (a playlist) the disc's film (item), for everyone, instead of the engine's pick.",
      "method": "PUT",
      "path": "/api/modules/wittybluray/discs/{item}/choice",
      "body": "{\"ttn\":\"{ttn}\"}",
      "params": [
        {
          "name": "ttn",
          "type": "int",
          "label": "Playlist",
          "required": true
        }
      ]
    },
    {
      "op": "wittybluray.clearChoice",
      "label": "Use the engine's pick",
      "description": "Forgets the film an administrator chose for the disc (item): the engine's pick plays again.",
      "method": "DELETE",
      "path": "/api/modules/wittybluray/discs/{item}/choice"
    },
    {
      "op": "wittybluray.rank",
      "label": "Rank again",
      "description": "An administrator has the engine work out which playlist of the disc (item) is the film again.",
      "method": "POST",
      "path": "/api/modules/wittybluray/discs/{item}/analysis",
      "body": "{\"secondOpinion\":false}"
    },
    {
      "op": "wittybluray.compare",
      "label": "Compare with libbluray",
      "description": "An administrator has a libbluray installed on the server compare its reading of the disc (item); the server's setting has to allow it.",
      "method": "POST",
      "path": "/api/modules/wittybluray/discs/{item}/analysis",
      "body": "{\"secondOpinion\":true}"
    }
  ]
